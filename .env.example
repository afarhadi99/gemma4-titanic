# Copy to .env and fill in. .env is gitignored: never commit it.

# Modal: dashboard > Settings > API Tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face read token (accept the Gemma license on the model page first)
HF_TOKEN=

# Kaggle: Settings > API > Create New Token (alternatively KAGGLE_USERNAME + KAGGLE_KEY)
KAGGLE_API_TOKEN=

# Optional training defaults (command-line flags override these)
# GEMMA_MODEL_ID=google/gemma-4-E2B-it
# MODAL_GPU=L40S
# FOLDS=5
# EPOCHS=3
# LR=1e-4
# SEED=42

# Optional TabPFN candidate for baseline.py (pip package: tabpfn). Never commit real values.
# TABPFN_VERSION: v2 (default without a token; weights download with no login),
#   v3.5-fast (default when TABPFN_TOKEN is set) or v3.5.
# The v3.5 weights are under a NON-COMMERCIAL license: accept it at https://ux.priorlabs.ai and copy the
# token from there. Without a token and with v3.5*, TabPFN is skipped with a one-line message.
TABPFN_TOKEN=
# TABPFN_VERSION=v3.5-fast

# Optional: restrict baseline.py candidates, e.g. BASELINE_MODELS=gb,svc,rf (default: all)
# BASELINE_MODELS=
