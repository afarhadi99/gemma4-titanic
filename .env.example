# Copy to .env and fill in. .env is gitignored: never commit it.

# Modal: dashboard > Settings > API Tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face read token (accept the Gemma license on the model page first)
HF_TOKEN=

# Kaggle: Settings > API > Create New Token (alternatively KAGGLE_USERNAME + KAGGLE_KEY)
KAGGLE_API_TOKEN=

# Optional training defaults (command-line flags override these)
# GEMMA_MODEL_ID=google/gemma-4-E2B-it
# MODAL_GPU=L40S
# FOLDS=5
# EPOCHS=3
# LR=1e-4
# SEED=42
